#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ ! -x "$repo_root/.venv/bin/python" ]]; then
    printf 'The project virtual environment is missing; rerun .agents/setup.\n' >&2
    exit 1
fi

printf 'No external services need to be resumed.\n'
