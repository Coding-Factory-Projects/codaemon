# ---- Django ----
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=codaemon.codingfactory.tech
DJANGO_CSRF_TRUSTED_ORIGINS=https://codaemon.codingfactory.tech
WEBSITE_BASE_URL=https://codaemon.codingfactory.tech

# ---- Runtime ----
GUNICORN_PORT=8200
GUNICORN_WORKERS=2
DATABASE_PATH=/app/data/db.sqlite3
# Set by CI on each deploy; defaults to "latest" locally.
IMAGE_TAG=latest

# ---- Discord (per environment: prod guild vs staging test guild) ----
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Optional in test mode: the bot finds or creates these roles by name.
DISCORD_ADMIN_ROLE_ID=
DISCORD_BASE_ROLE_ID=
DISCORD_GUEST_ROLE_ID=
DISCORD_PRODUCT_OWNERS_ROLE_ID=
# Defaults to DISCORD_GUILD_ID (the @everyone role id == the guild id). Override only if needed.
# DISCORD_EVERYONE_ROLE_ID=

# ---- learnd integration (shared secret, both directions) ----
LEARND_BASE_URL=https://learnd.example.com
SHARED_SECRET=
SHARED_SECRET_HEADER=X-Shared-Secret

# ---- Email (Mailgun over SMTP) ----
EMAIL_HOST=smtp.eu.mailgun.org
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Coding Factory <bot@codingfactory.tech>

# ---- Onboarding ----
ALLOWED_EMAIL_DOMAINS=edu.itescia.fr,edu.esiee-it.fr

# ---- Explicit test mode (never enable in production) ----
# Uses the JSON student fixture instead of learnd and returns the confirmation
# link ephemerally in Discord instead of sending email.
CODAEMON_TEST_MODE=false
LEARND_FIXTURE_PATH=fixtures/students.json
