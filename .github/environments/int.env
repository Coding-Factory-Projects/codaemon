# Integration configuration. Secrets come from the GitHub int environment's DOTENV secret.
PROJECT_ENV=int
# Allowed values: fixture, learnd.
STUDENT_BACKEND=learnd
# Send confirmation email in int; allowed values: email, link.
ONBOARD_DELIVERY=email
LEARND_FIXTURE_PATH=fixtures/students.json
ALLOWED_EMAIL_DOMAINS=edu.itescia.fr,edu.esiee-it.fr,gmail.com
LEARND_BASE_URL=https://int.learnd.sh
DJANGO_ALLOWED_HOSTS=codaemon-int.codingfactory.tech
DJANGO_CSRF_TRUSTED_ORIGINS=https://codaemon-int.codingfactory.tech
WEBSITE_BASE_URL=https://codaemon-int.codingfactory.tech
GUNICORN_PORT=8200

# Email
EMAIL_HOST=smtp.eu.mailgun.org
EMAIL_PORT=587
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Coding Factory <bot@codingfactory.tech>
